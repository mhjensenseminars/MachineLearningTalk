\section{Introduction: QONTROL at a Glance}

\begin{frame}{QONTROL: Mission and Vision}
  \begin{columns}[T]
    \column{0.57\textwidth}
      \begin{block}{Mission}
        Develop theoretical, computational, and experimental tools
        to \textbf{control quantum states} in atoms, molecules, and
        materials -- underpinning the \emph{second quantum revolution}.
      \end{block}
      \vspace{2pt}
      \begin{alertblock}{Central scientific question}
        \textit{How can we engineer external forces to make quantum
        systems behave as we desire?}
      \end{alertblock}
      \vspace{2pt}
      \begin{block}{Key quantum concepts}
        Superposition \quad\textbullet\quad Interference \quad\textbullet\quad Entanglement
      \end{block}
    \column{0.41\textwidth}
      \begin{block}{Systems covered}
        \begin{itemize}
          \item Atoms \& molecules
          \item Nanoscale systems / quantum dots
          \item Solid-state defects
          \item Quantum materials
        \end{itemize}
      \end{block}
      \vspace{2pt}
      \begin{block}{Duration \& host}
        \textbf{2028--2037} (two 5-year periods)\\
        University of Oslo (UiO)
      \end{block}
      \vspace{2pt}
      \begin{block}{Controllability}
        Drive any initial state to a chosen final state in
        finite time using admissible controls.
      \end{block}
  \end{columns}
\end{frame}

\begin{frame}{The Four Research Tracks}
  \begin{center}
  \renewcommand{\arraystretch}{1.35}
  \begin{tabular}{>{\bfseries\color{qontrolblue}}c
