\section{RT2: Quantum Dynamics}

\begin{frame}{RT2 -- Quantum Dynamics: Scope \& Objectives}
  \begin{columns}[T]
    \column{0.54\textwidth}
      \begin{block}{Scope}
        Understanding and \textbf{steering the time evolution}
        of quantum systems: free and driven dynamics,
        beyond few-level models, with relativistic effects.
      \end{block}
      \vspace{2pt}
      \begin{block}{Key scientific challenges}
        \begin{itemize}
          \item Model \textbf{open quantum systems} with realistic environments
          \item Design \textbf{optimal inverse-control strategies}
          \item Mitigate \textbf{decoherence and noise}
          \item Time-dependent many-body theory for ionization processes
          \item ML-guided control from high-accuracy simulations
        \end{itemize}
      \end{block}
    \column{0.44\textwidth}
      \begin{alertblock}{Beyond-state-of-the-art objectives}
        \begin{enumerate}
          \item Theory and experiment for qubit time evolution
                in nanoscale systems
          \item Reveal ultrafast quantum dynamics via attosecond
                probing and modeling
        \end{enumerate}
      \end{alertblock}
      \vspace{2pt}
      \begin{block}{Principal Investigators (Fig.\,3)}
        \textbf{Atoms \& Molecules:} TBP, MR\\[2pt]
        \textbf{Nanoscale Systems:} MEB, SK\\[2pt]
        \textbf{Quantum Materials:} JW, LV
      \end{block}
      \vspace{2pt}
      \begin{block}{Attosecond chemistry}
        Laser pulses on the electron time scale enable control
        of chemical reactions via electron--nuclear entanglement.
      \end{block}
  \end{columns}
\end{frame}

\begin{frame}{RT2 -- Quantum Dynamics: Methods \& Tools}
  \begin{columns}[T]
    \column{0.48\textwidth}
      \begin{block}{Theoretical framework}
        Unified framework combining \textbf{theoretical modeling,
        simulation, and data-driven control}:
        \begin{itemize}
          \item Time-dependent many-body theory for open systems
          \item Optimal control theory (GRAPE, CRAB, \ldots)
          \item Lindblad / non-Markovian master equations
          \item Connects experimental observations with theory
        \end{itemize}
      \end{block}
    \column{0.48\textwidth}
      \begin{block}{Machine-learning guidance}
        \begin{itemize}
          \item Reinforcement learning for optimal pulse design
          \item ML-guided control from high-accuracy simulations
          \item Programmable quantum evolution and robust qubits
          \item Generative models for control-landscape exploration
        \end{itemize}
      \end{block}
  \end{columns}
  \vspace{4pt}
  \begin{alertblock}{Key ambition}
    Develop time-dependent many-body theories for
    \textbf{open quantum systems including ionization processes},
    creating a unified framework connecting experiment with theory.
  \end{alertblock}
\end{frame}

