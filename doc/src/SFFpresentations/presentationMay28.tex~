\section{RT1: Quantum Correlations}

\begin{frame}{RT1 -- Quantum Correlations: Scope \& Objectives}
  \begin{columns}[T]
    \column{0.54\textwidth}
      \begin{block}{Scope}
        Addresses fundamental correlations in
        \textbf{many-body quantum systems}: atoms, molecules,
        quantum dots, and correlated materials.
      \end{block}
      \vspace{2pt}
      \begin{block}{Key scientific challenges}
        \begin{itemize}
          \item Beyond mean-field toward \textbf{predictive many-body treatments}
          \item Entangled relativistic \& non-relativistic electronic states
          \item Correlated electron--nuclear motion beyond Born--Oppenheimer
          \item Mechanisms of \textbf{defect--qubit} formation and exotic
                correlated-material phenomena
        \end{itemize}
      \end{block}
    \column{0.44\textwidth}
      \begin{alertblock}{Beyond-state-of-the-art objectives}
        \begin{enumerate}
          \item Realize and characterize superposition and
                entanglement in quantum systems
          \item Explore non-classical correlations in chemical
                bond breaking and formation
        \end{enumerate}
      \end{alertblock}
      \vspace{2pt}
      \begin{block}{Principal Investigators (Fig.\,3)}
        \textbf{Atoms \& Molecules:}
          T.\,B.\,Pedersen (TBP), M.\,Repi\v{s}k\'{y} (MR)\\[2pt]
        \textbf{Nanoscale Systems:}
          M.\,E.\,Bathen (MEB), S.\,Kvaal (SK)\\[2pt]
        \textbf{Quantum Materials:}
          J.\,Wells (JW), L.\,Vines (LV)
      \end{block}
  \end{columns}
\end{frame}

\begin{frame}{RT1 -- Quantum Correlations: Research Highlights}
  \begin{block}{Electrons on liquid helium and quantum dots\normalfont\small(Hjorth-Jensen et al., PRX Quantum 2024)}
    Coulomb interactions tuned by electric fields to create
    \textbf{charge qubits with long coherence times}.
    Exact experimental and theoretical treatment; basis for
    prototype quantum gates, circuits and sensors.
  \end{block}
  \vspace{2pt}
  \begin{block}{Beyond Born--Oppenheimer \normalfont\small(Pedersen, Kvaal et al., JACS 2024)}
    First extraction of molecular and electronic structure from
    all-particle non-BO wave functions by stochastic sampling of
    conditional quantum probability distributions -- essential for
    interpreting \textbf{attosecond quantum dynamics simulations}.
  \end{block}
  \vspace{2pt}
  \begin{block}{Silicon-vacancy defects in SiC \normalfont\small(Bathen, Vines et al., npj QI 2019)}
    Theory, computation, and experiment to identify and control
    charge-transition levels and phonon couplings of
    \textbf{single-photon emitters and spin qubits} in 4H--SiC,
    advancing integration into quantum devices.
  \end{block}
\end{frame}

