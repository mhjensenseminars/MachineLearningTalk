\section{RT3: Quantum Readout}

\begin{frame}{RT3 -- Quantum Readout: Scope \& Objectives}
  \begin{columns}[T]
    \column{0.54\textwidth}
      \begin{block}{Scope}
        Characterising quantum states through \textbf{measurement}:
        cornerstone of quantum computing, sensing, and metrology.
        Targets enhanced detection sensitivity via quantum correlations.
      \end{block}
      \vspace{2pt}
      \begin{block}{Key scientific challenges}
        \begin{itemize}
          \item \textbf{Critical quantum sensing}: exploit proximity to
                quantum phase transitions for enhanced precision
          \item Study quantum material response to minute perturbations
                to optimise measurement fidelity
          \item Deepen the role of superposition, interference, and
                entanglement in quantum information processing
          \item \emph{In operando} characterisation of prototype devices
        \end{itemize}
      \end{block}
    \column{0.44\textwidth}
      \begin{alertblock}{Beyond-state-of-the-art objectives}
        \begin{enumerate}
          \item Enhance sensitivity using superposition,
                interference, and entanglement
          \item \textit{In operando} characterisation of
                prototype quantum devices
        \end{enumerate}
      \end{alertblock}
      \vspace{2pt}
      \begin{block}{Principal Investigators (Fig.\,3)}
        \textbf{Atoms \& Molecules:} TBP, MR\\[2pt]
        \textbf{Nanoscale Systems:} MEB, SK\\[2pt]
        \textbf{Quantum Materials:} JW, LV
      \end{block}
      \vspace{2pt}
      \begin{block}{Role across all tracks}
        RT3 specifically deepens the role of entanglement
        in \textbf{sensing and information processing}.
      \end{block}
  \end{columns}
\end{frame}

